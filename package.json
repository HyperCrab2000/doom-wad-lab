{
  "name": "doom-wad-lab",
  "version": "0.0.1",
  "description": "Doom/Doom II WAD level renderer and KVX voxel viewer",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "dev": "vite --port 5150",
    "dev:quick": "VITE_SKIP_WASM_BUILD=1 vite --host 127.0.0.1 --port 5150",
    "dev:rt": "vite --port 5151",
    "build": "vite build",
    "package:release": "npm run build && npx tsx tools/release/package-release.mts",
    "release:backfill": "npx tsx tools/release/backfill-release-notes.mts",
    "release:notes": "npx tsx tools/release/write-release-notes.mts",
    "release:publish": "npx tsx tools/release/publish-github-releases.mts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:fast": "VITEST_MAX_WORKERS=100% vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project integration test/integration/e1m1-browser-render.integration.test.ts",
    "test:coverage": "VITEST_COVERAGE=1 vitest run --project unit --coverage",
    "export:logo": "npx tsx scripts/export-doom-logo.ts public/wads/DOOM.WAD",
    "test:console": "npx tsx scripts/capture-console-errors.ts",
    "test:load": "npm run test:load:chrome && npm run test:load:firefox",
    "test:black-screen": "npm run test:load",
    "test:load:chrome": "npx tsx scripts/verify-e1m1-load.ts",
    "test:map-load-deadline": "npx tsx scripts/verify-map-load-deadline.mts",
    "test:repro-e1m1": "npx tsx scripts/repro-e1m1-load.mts",
    "test:gzdoom-play": "npx tsx scripts/diagnose-gzdoom-play.mts",
    "test:gzdoom-play:cold": "npx tsx scripts/diagnose-gzdoom-play-cold.mts",
    "fix:2c:t1": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T1 --recapture",
    "fix:2c:t2": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T2 --recapture",
    "fix:2c:t3": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T3 --recapture",
    "fix:2c:t4": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T4 --recapture",
    "fix:2c:a": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T1 --recapture",
    "fix:2c:b": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T2 --recapture",
    "fix:2c:c": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T3 --recapture",
    "fix:2c:d": "npx tsx tools/gzrender-v2/fix-2c-tier.mts --tier T4 --recapture",
    "test:load:firefox": "npx tsx scripts/verify-firefox-load.ts",
    "test:load:diag": "npx tsx scripts/diagnose-load.ts",
    "test:pathtrace": "npx tsx scripts/verify-pathtrace-e1m1.ts",
    "test:pathtrace:gpu": "npx tsx scripts/gpu-shader-isolated.ts && node scripts/compare-gpu-cpu-pathtrace.mjs",
    "test:music": "npx tsx scripts/test-opl3-browser.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "corpus:parity": "tsx tools/gzrender-v2/corpus-parity.mts",
    "corpus:parity:static": "tsx tools/gzrender-v2/corpus-parity.mts --static",
    "corpus:parity:all": "tsx tools/gzrender-v2/corpus-parity.mts --static public/wads/DOOM.WAD && tsx tools/gzrender-v2/corpus-parity.mts --static public/wads/DOOM2.WAD",
    "test:corpus": "GZRENDER_CORPUS_REQUIRED=1 vitest run --project unit src/wad/parity/corpus.parity.test.ts",
    "corpus:gztick": "bash tools/gzrender-v2/dump-gzdoom-gztick.sh",
    "test:gztick-parity": "GZTICK_PARITY_REQUIRED=1 vitest run --project unit src/wad/federated/gztickParity.test.ts",
    "test:wad-data": "WAD_DATA_PARITY_REQUIRED=1 vitest run --project unit src/wad/parity/wadDataParity.test.ts",
    "test:import-oracle": "IMPORT_ORACLE_REQUIRED=1 vitest run --project unit src/wad/parity/importOracle.test.ts",
    "import-oracle:corpus": "tsx tools/gzrender-v2/import-oracle-corpus.mts",
    "import-oracle:corpus:all": "tsx tools/gzrender-v2/import-oracle-corpus.mts public/wads/DOOM.WAD && tsx tools/gzrender-v2/import-oracle-corpus.mts public/wads/DOOM2.WAD",
    "gold-standard:dump": "tsx tools/gzrender-v2/dump-gzdoom-gold-standard.mts",
    "gold-standard:dump:all": "tsx tools/gzrender-v2/dump-gzdoom-gold-standard.mts public/wads/DOOM.WAD && tsx tools/gzrender-v2/dump-gzdoom-gold-standard.mts public/wads/DOOM2.WAD",
    "gold-standard:materialize": "tsx tools/gzrender-v2/materialize-gold-standard.mts",
    "gold-standard:regenerate-gles": "tsx tools/gzrender-v2/regenerate-gold-standard-gles.mts",
    "gold-standard:regenerate-modes": "tsx tools/gzrender-v2/regenerate-gold-display-modes.mts",
    "gold-standard:regenerate-modes:all": "tsx tools/gzrender-v2/regenerate-gold-display-modes.mts public/wads/DOOM.WAD && tsx tools/gzrender-v2/regenerate-gold-display-modes.mts public/wads/DOOM2.WAD",
    "build:gzdoom-wasm": "bash tools/gzrender-v2/build-gzdoom-wasm.sh",
    "build:gzdoom-s-wasm": "bash tools/gzrender-v2/build-gzdoom-s-pure-wasm.sh",
    "bootstrap:gzdoom-s": "bash tools/gzrender-v2/bootstrap-gzdoom-s-from-gold.sh",
    "test:gzdoom-s-play": "RENDERER=gzdoom-s-wasm npx tsx tools/gzrender-v2/test-hosted-play.mts E1M1",
    "test:gzdoom-s-layers": "npx tsx tools/gzrender-v2/test-gzdoom-s-layers.mts",
    "test:classic-layers": "npx tsx tools/gzrender-v2/test-classic-layers.mts",
    "test:classic-layers-matrix": "npx tsx tools/gzrender-v2/test-classic-layers-matrix.mts",
    "test:compare-classic-modular": "npx tsx tools/gzrender-v2/compare-classic-modular-spawn.mts",
    "test:compare-classic-modular-maps": "npx tsx tools/gzrender-v2/compare-classic-modular-maps.mts",
    "test:classic-smoke": "npx tsx tools/gzrender-v2/verify-classic-smoke.mts",
    "test:classic-play-smoke": "npx tsx tools/gzrender-v2/test-classic-play-smoke.mts",
    "test:classic-parity-play": "npx tsx tools/gzrender-v2/test-classic-play-smoke.mts",
    "test:classic-gameplay": "npx tsx tools/gzrender-v2/verify-classic-gameplay.mts",
    "test:classic-gzdoom-parity": "npx tsx tools/gzrender-v2/test-classic-gzdoom-parity.mts",
    "test:classic-parity-buckets": "npx tsx tools/gzrender-v2/analyze-classic-parity-buckets.mts",
    "test:classic-parity-buckets-gate": "npx tsx tools/gzrender-v2/test-classic-parity-bucket-gates.mts",
    "test:classic-parity-ceiling": "CLASSIC_PARITY_BUCKET=ceiling CLASSIC_PARITY_MAX_MISMATCH=1 npx tsx tools/gzrender-v2/test-classic-parity-bucket-gates.mts",
    "test:classic-parity-mid-upper": "CLASSIC_PARITY_BUCKET=mid-upper CLASSIC_PARITY_MAX_MISMATCH=1 npx tsx tools/gzrender-v2/test-classic-parity-bucket-gates.mts",
    "test:classic-parity-probes": "npx tsx tools/gzrender-v2/test-classic-parity-probes.mts",
    "test:classic-parity-corpus": "npx tsx tools/gzrender-v2/test-classic-parity-corpus.mts",
    "capture:honest-parity": "npx tsx tools/gzrender-v2/capture-honest-parity.mts",
    "test:honest-parity": "npx tsx tools/gzrender-v2/test-honest-parity-corpus.mts",
    "test:honest-parity:gate": "HONEST_PARITY_REQUIRED=1 HONEST_PARITY_CAPTURE=1 npx tsx tools/gzrender-v2/test-honest-parity-corpus.mts",
    "test:honest-parity:native": "HONEST_PARITY_NATIVE=1 HONEST_PARITY_CAPTURE=1 npx tsx tools/gzrender-v2/test-honest-parity-corpus.mts",
    "test:classic-parity-iterate": "npx tsx tools/gzrender-v2/iterate-classic-parity.mts",
    "capture:classic-spawn-gold": "npx tsx tools/gzrender-v2/capture-classic-spawn-gold.mts",
    "capture:classic-spawn-webgl": "npx tsx tools/gzrender-v2/capture-classic-spawn-webgl.mts",
    "capture:classic-spawn-offline": "npx tsx tools/gzrender-v2/capture-classic-spawn-offline.mts",
    "test:classic-parity-strict": "npx tsx tools/gzrender-v2/test-classic-parity-strict.mts",
    "test:classic-parity-layers": "npx tsx tools/gzrender-v2/compare-classic-parity-layers.mts",
    "test:diamond": "npx tsx tools/gzrender-v2/diamond-e2e-suite.mts",
    "test:pyramid": "npm run test:unit && npm run test:integration && npm run test:diamond",
    "generate:docs": "npx tsx tools/docs/generate-bible-expansion.mts",
    "verify:gold-wasm": "bash tools/gzrender-v2/verify-gold-wasm-artifact.sh",
    "test:gzdoom-wasm-prereqs": "GZDOOM_WASM_PREREQS_REQUIRED=1 vitest run --project unit src/wad/parity/gzdoomWasmPrereqs.test.ts",
    "test:gzdoom-wasm-frame": "GZDOOM_WASM_FRAME_REQUIRED=1 vitest run --project unit src/wad/parity/gzdoomWasmFrameParity.test.ts",
    "test:gzdoom-wasm-corpus": "GZDOOM_WASM_CORPUS_REQUIRED=1 vitest run --project unit src/wad/parity/gzdoomWasmCorpus.test.ts",
    "gzdoom-wasm:corpus": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts",
    "gzdoom-wasm:corpus:strict": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts --gate strict",
    "gzdoom-wasm:corpus:edge": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts --gate edge",
    "gzdoom-wasm:corpus:bandaid": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts --gate bandaid",
    "gzdoom-wasm:corpus:all": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts public/wads/DOOM.WAD --gate bandaid; tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts public/wads/DOOM2.WAD --gate bandaid",
    "gzdoom-wasm:corpus:all:strict": "tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts public/wads/DOOM.WAD --gate strict; tsx tools/gzrender-v2/gzdoom-wasm-corpus.mts public/wads/DOOM2.WAD --gate strict",
    "gzdoom-wasm:corpus:eval": "tsx tools/gzrender-v2/evaluate-gzdoom-wasm-corpus.mts",
    "gzdoom-wasm:corpus:eval:all": "tsx tools/gzrender-v2/evaluate-gzdoom-wasm-corpus.mts public/wads/DOOM.WAD public/wads/DOOM2.WAD",
    "gzdraw-corpus:spawn:eval": "tsx tools/gzrender-v2/evaluate-gzdraw-spawn-corpus.mts",
    "gzdoom-wasm:corpus:report": "tsx tools/gzrender-v2/summarize-corpus-failures.mts DOOM && tsx tools/gzrender-v2/summarize-corpus-failures.mts DOOM2",
    "gzdoom-wasm:materialize-wasm-gold": "tsx tools/gzrender-v2/materialize-wasm-gold-refs.mts --bandaid-list",
    "gzdoom-wasm:materialize-wasm-gold:non-strict": "tsx tools/gzrender-v2/materialize-wasm-gold-refs.mts --non-strict",
    "display-mode:corpus": "tsx tools/gzrender-v2/display-mode-corpus.mts",
    "display-mode:corpus:all": "tsx tools/gzrender-v2/display-mode-corpus.mts public/wads/DOOM.WAD; tsx tools/gzrender-v2/display-mode-corpus.mts public/wads/DOOM2.WAD",
    "display-mode:diagnose": "tsx tools/gzrender-v2/diagnose-parity-layers.mts",
    "capture:gzdoom-wasm-frame": "tsx tools/gzrender-v2/capture-gzdoom-wasm-frame.mts",
    "capture:gzstate-import-frame": "tools/gzrender-v2/capture-gzstate-import-frame.sh",
    "export:node-gzstate": "tsx tools/gzrender-v2/export-node-gzstate.mts",
    "test:modular": "vitest run --project unit src/wad/renderer/modular/modularStageParity.test.ts",
    "test:federated": "vitest run --project unit src/wad/renderer/gzrender-v2/federated/federatedCourtyardParity.test.ts",
    "test:parity-gates": "npm run test:wad-data && npm run test:corpus && npm run test:import-oracle && npm run test:gzdoom-wasm-prereqs && npm run test:gzdoom-wasm-corpus && npm run test:gzdraw-corpus && npm run test:modular && npm run test:federated && npm run test:frame",
    "test:parity-gates:hard": "npm run test:wad-data && npm run test:corpus && npm run test:modular && npm run test:federated && GZFRAME_PARITY_REQUIRED=1 npm run test:frame",
    "mod:parity": "tsx tools/gzrender-v2/mod-corpus-parity.mts --all",
    "test:mod-parity": "vitest run --project unit src/wad/mod/modStackParity.test.ts",
    "test:frame": "vitest run --project unit src/wad/parity/frame/e1m1FrameParity.test.ts",
    "capture:gzdoom-frame": "tools/gzrender-v2/capture-gzdoom-ref-frame.sh",
    "verify:gzdraw-native": "tsx tools/gzrender-v2/verify-gzdraw-native.mts",
    "verify:gzdraw-wasm": "tsx tools/gzrender-v2/verify-gzdraw-wasm.mts",
    "gzdraw-corpus": "tsx tools/gzrender-v2/gzdraw-corpus.mts",
    "gzdraw-corpus:native": "tsx tools/gzrender-v2/gzdraw-corpus.mts --native-only",
    "gzdraw-corpus:wasm": "tsx tools/gzrender-v2/gzdraw-corpus.mts --wasm",
    "test:gzdraw-corpus": "tsx tools/gzrender-v2/gzdraw-corpus.mts --wasm --maps E1M1 --probes 0",
    "test:gzdraw-corpus:spawn-all": "bash tools/gzrender-v2/run-gzdraw-spawn-corpus.sh",
    "gzdraw-corpus:spawn-all": "bash tools/gzrender-v2/run-gzdraw-spawn-corpus.sh",
    "gzdraw-corpus:wave4-native": "bash tools/gzrender-v2/run-wave4-native-baseline.sh",
    "capture:wadlab-frame": "tsx tools/gzrender-v2/capture-wadlab-ref-frame.mts",
    "diff:frame": "tsx tools/gzrender-v2/diff-frame.ts artifacts/gzrender-v2/gzdoom/E1M1.png artifacts/gzrender-v2/wadlab/E1M1.png",
    "build:wasm": "node tools/gzrender-v2/build-federated-wasm.mjs",
    "build:wad-core": "npm run build --prefix ../doom-wad-core",
    "predev": "bash -c 'test \"$VITE_SKIP_WASM_BUILD\" = 1 && exit 0; npm run build:wad-core && bash tools/gzrender-v2/bootstrap-gzdoom-s-if-missing.sh'",
    "prebuild": "npm run build:wasm"
  },
  "author": "Andrew Lowndes",
  "license": "MIT",
  "dependencies": {
    "@hypercrab2000/doom-gzengine-core": "file:../doom-gzengine-core",
    "@hypercrab2000/doom-wad-core": "file:../doom-wad-core",
    "@types/matter-js": "^0.20.2",
    "apl-easy-gl": "^0.4.0",
    "apl-image-packer": "^1.1.0",
    "earcut": "^3.0.1",
    "matter-js": "^0.20.0",
    "opl3": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spessasynth_core": "^4.3.5",
    "three": "^0.175.0"
  },
  "homepage": "https://github.com/andrewlowndes/doom",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.60.0",
    "@types/earcut": "^3.0.0",
    "@types/gl-matrix": "^2.4.5",
    "@types/http-server": "^0.12.4",
    "@types/jdataview": "^0.0.34",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.1.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "file-loader": "^6.2.0",
    "gl-matrix": "^3.4.3",
    "globals": "^16.0.0",
    "glsl-parser": "^2.0.1",
    "html-loader": "^5.1.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-glsl": "^0.2.1",
    "puppeteer": "^24.4.0",
    "sirv": "^3.0.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.3",
    "vite-plugin-string": "^1.2.3",
    "vitest": "^3.0.9",
    "wabt": "^1.0.36",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}

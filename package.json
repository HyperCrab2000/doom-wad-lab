{
  "name": "doom-wad-lab",
  "version": "0.0.1",
  "description": "Doom/Doom II WAD level renderer and KVX voxel viewer",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:console": "tsx scripts/capture-console-errors.ts",
    "test:music": "tsx scripts/test-opl3-browser.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,html}\""
  },
  "author": "Andrew Lowndes",
  "license": "MIT",

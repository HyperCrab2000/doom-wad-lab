    "apl-image-packer": "^1.1.0",
    "earcut": "^3.0.1",
    "matter-js": "^0.20.0",
    "opl3": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spessasynth_core": "^4.3.5",
    "three": "^0.175.0"
  },
  "homepage": "https://github.com/andrewlowndes/doom",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/earcut": "^3.0.0",
    "@types/gl-matrix": "^2.4.5",
    "@types/http-server": "^0.12.4",
    "@types/jdataview": "^0.0.34",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.1.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "file-loader": "^6.2.0",
    "gl-matrix": "^3.4.3",
    "globals": "^16.0.0",
    "glsl-parser": "^2.0.1",
    "html-loader": "^5.1.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
